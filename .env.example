# ==============================================================================
# Jilani Autos / Bike Software Environment Configuration
# ==============================================================================
# Copy to .env.local for local development.
# On Vercel / production host, set these in the dashboard Environment Variables.
# ==============================================================================

# NextAuth Secret (REQUIRED in production — no fallback)
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=your_generated_random_secret_here

# Public base URL of the deployed app (no trailing slash)
# Local:  http://localhost:3000
# Live:   https://your-domain.com
NEXTAUTH_URL=http://localhost:3000

# MongoDB Atlas connection string (REQUIRED in production)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/bikesoftware?retryWrites=true&w=majority

# Required on FIRST production seed (empty users collection) — min 8 characters each.
# After the DB is seeded, you can remove these from the host env if you want.
SUPERADMIN_INITIAL_PASSWORD=change_me_superadmin_min_8_chars
ADMIN_INITIAL_PASSWORD=change_me_shopadmin_min_8_chars
