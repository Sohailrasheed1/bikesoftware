# ==============================================================================
# Jilani Autos / Bike Software Environment Configuration
# ==============================================================================

# NextAuth Secret
# In development, a fallback secret will be used if omitted.
# In PRODUCTION, NEXTAUTH_SECRET is STRICTLY REQUIRED!
# Generate a strong 32-byte secret using: openssl rand -base64 32
NEXTAUTH_SECRET=your_generated_random_secret_here

# Base URL for the application
NEXTAUTH_URL=http://localhost:3000

# MongoDB Database Connection String (MongoDB Atlas or local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/bikesoftware?retryWrites=true&w=majority

# Optional: Initial setup passwords for new database seeding (minimum 8 characters)
# If left unset, default secure bcrypt hashes will be used for seeded demo accounts.
# SUPERADMIN_INITIAL_PASSWORD=your_secure_superadmin_password_min_8_chars
# ADMIN_INITIAL_PASSWORD=your_secure_shopadmin_password_min_8_chars
